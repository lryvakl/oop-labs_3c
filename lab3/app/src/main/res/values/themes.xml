        <!-- Основні кольори -->
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryVariant">#000000</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- ЦЕ РОБИТЬ СТАТУС БАР ЧОРНИМ -->
